# The library reads no environment variables. These are for the corpus scripts
# under scripts/corpus/ only.

# Contact address sent in the User-Agent and polite-pool parameters when the
# corpus scripts call Europe PMC, arXiv, Crossref, and OpenAlex.
CORPUS_CONTACT_EMAIL=

# OpenAlex API key (free account). Needed only to sample OpenAlex's cached Grobid
# TEI (content.openalex.org); each download draws $0.01 from the daily budget.
OPENALEX_API_KEY=
