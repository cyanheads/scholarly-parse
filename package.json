{
  "name": "scholarly-parse",
  "version": "0.1.0",
  "description": "Parse scholarly papers — JATS, Grobid TEI, arXiv HTML, publisher HTML, PDF — into one document model and Markdown.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/scholarly-parse.git"
  },
  "homepage": "https://github.com/cyanheads/scholarly-parse#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/scholarly-parse/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "keywords": [
    "jats",
    "tei",
    "grobid",
    "latexml",
    "arxiv",
    "pubmed-central",
    "europe-pmc",
    "scholarly",
    "scientific-papers",
    "full-text",
    "pdf",
    "pdf-to-markdown",
    "html-to-markdown",
    "markdown",
    "parser",
    "llm",
    "rag",
    "typescript"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.2",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "changelog/", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "rebuild": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:corpus": "vitest run tests/corpus",
    "corpus:snapshot": "SCHOLARLY_PARSE_UPDATE_SNAPSHOTS=1 vitest run tests/corpus",
    "corpus:sample": "bun run scripts/corpus/sample.ts",
    "corpus:attribution": "bun run scripts/corpus/attribution.ts",
    "changelog:build": "bun run scripts/build-changelog.ts",
    "changelog:check": "bun run scripts/build-changelog.ts --check",
    "tree": "bun run scripts/tree.ts",
    "list-skills": "bun run scripts/list-skills.ts",
    "devcheck": "bun run scripts/devcheck.ts",
    "release:github": "bun run scripts/release-github.ts",
    "prepublishOnly": "bun run devcheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "ignore": "^7.0.10",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  }
}
